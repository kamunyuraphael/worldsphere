# Browser-visible Vite values. Never place secrets in VITE_ variables.
# WorldSphere server (accounts, favorites, AI chat). Required in production.
VITE_API_URL=http://localhost:8000
# ML service (risk predictor + model insights). Required in production.
VITE_ML_API_URL=http://localhost:8001
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors

# --- Image tooling (scripts/, not the browser bundle — server-side only, never VITE_-prefixed) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UNSPLASH_ACCESS_KEY=
APP_NAME=worldsphere
